# Variables de entorno para el Nodo Satelite
# Copia este archivo a .env y edita los valores

# Contrasena de la base de datos local del satelite
DB_PASSWORD=fmcpassword

# Secreto JWT del satelite (debe ser unico, no compartir con otros nodos)
JWT_SECRET=satellite-jwt-secret-change-me

# Clave privada Ed25519 del nodo satelite (hex)
# Generar con: openssl rand -hex 32
NODE_PRIVATE_KEY=

# Dominio del nodo padre (ej: nodo1.com)
PARENT_NODE=nodo1.com
